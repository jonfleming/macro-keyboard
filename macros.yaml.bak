model: ch57x-1
orientation: normal

rows: 3
columns: 4
knobs: 3

layers:
  - buttons:
      - ["shift-a,m,i,c,u,s,dot,4,4,enter", "j,o,n,tab,shift-a,m,i,c,u,s,dot,4,4,enter", "shift-r,a,s,p,b,e,r,r,y,space,shift-p,i", "h,o,m,e,enter,c,l,s,enter"]
      - ["shift-s,shift-e,shift-f,0,5,0,7,9,5,shift-1", "backspace", "shift-left", "shift-right"]
      - ["space", "win-b", "left", "right"]
    knobs:
      - ccw: "volumedown"
        press: "mute"
        cw: "volumeup"
      - ccw: "ctrl-win-left"
        press: "calculator"
        cw: "ctrl-win-right"
      - ccw: "ctrl-shift-alt-j"
        press: "click"
        cw: "ctrl-shift-alt-k"

  - buttons:
      - ["z", "slash", "shift-s,shift-e,shift-f,0,5,0,7,9,5,shift-1", "h,o,m,e,enter,c,l,s,enter"]
      - ["win-z", "backspace", "shift-left", "shift-right"]
      - ["space", "win-b", "left", "right"]
    knobs:
      - ccw: "volumedown"
        press: "mute"
        cw: "volumeup"
      - ccw: "ctrl-shift-alt-left"
        press: "click"
        cw: "ctrl-shift-alt-right"
      - ccw: "ctrl-shift-alt-j"
        press: "click"
        cw: "ctrl-shift-alt-k"

  - buttons:
      - ["ctrl-shift-alt-f1", "ctrl-shift-alt-f2", "ctrl-shift-alt-f3", "ctrl-shift-alt-f4"]
      - ["ctrl-shift-alt-f5", "ctrl-shift-alt-f6", "ctrl-shift-alt-f7", "ctrl-shift-alt-f8"]
      - ["ctrl-shift-alt-f9", "ctrl-shift-alt-f10", "ctrl-shift-alt-f11", "ctrl-shift-alt-f12"]
    knobs:
      - ccw: "wheeldown"
        press: "click"
        cw: "wheelup"
      - ccw: "ctrl-wheeldown"
        press: "rclick"
        cw: "ctrl-wheelup"
      - ccw: "volumedown"
        press: "mute"
        cw: "volumeup"
