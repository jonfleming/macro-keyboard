{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Download (yaml → txt)",
            "type": "debugpy",
            "request": "launch",
            "program": "converter.py",
            "args": ["download"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Upload (txt → yaml → keypad)",
            "type": "debugpy",
            "request": "launch",
            "program": "converter.py",
            "args": ["upload"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Validate mapping",
            "type": "debugpy",
            "request": "launch",
            "program": "converter.py",
            "args": ["validate"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Test Macro Parser",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": ["test_macro_parser.py"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
